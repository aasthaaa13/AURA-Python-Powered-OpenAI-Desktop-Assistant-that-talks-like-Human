# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- AI engine --------------------------------------------------------------
# Key from https://platform.openai.com/api-keys — starts with "sk-".
# Without it the HUD runs on the offline engine (built-in commands still work).
OPENAI_API_KEY=
# Any model your account can use. Change this if you get a "model not found".
OPENAI_MODEL=gpt-4o-mini

# auto (default) = use whichever key is set below, preferring OpenAI.
# openai | ollama | claude | offline to pin one explicitly.
# Ollama is never auto-selected: a local server needs no key, so there is
# nothing to detect. Set this to "ollama" to use it.
AURA_AI_PROVIDER=auto

# --- Ollama (local or self-hosted models) ------------------------------------
# A LOCAL Ollama needs NO API KEY — just `ollama serve` and `ollama pull <model>`,
# then set AURA_AI_PROVIDER=ollama. Leave OLLAMA_API_KEY blank.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Only for Ollama's hosted service or an instance behind an authenticating
# proxy — sent as the bearer token. Blank for a normal local install.
OLLAMA_API_KEY=

# Optional alternative backend — only used with AURA_AI_PROVIDER=claude,
# or with auto when no OpenAI key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- voice ------------------------------------------------------------------
AURA_SPEECH_ENABLED=true
AURA_TTS_ENABLED=true
# Mic override: device index or a substring of its name. Blank = system default.
AURA_INPUT_DEVICE=
AURA_LISTEN_MAX_SECONDS=8
AURA_LISTEN_SILENCE_SECONDS=1.2

# --- optional ElevenLabs voice (falls back to the OS voice when unset) -------
# The API key itself, which starts with "sk_" — not the key ID from the dashboard.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- interface --------------------------------------------------------------
# Seconds between system-metric samples.
AURA_MONITOR_INTERVAL=1.5

# --- interface ---------------------------------------------------------------
# Who AURA greets by name.
AURA_USER_NAME=Hasib
# mini (default) = small orb window. hud = the old fullscreen dashboard, which
# repaints enough to interfere with audio; the orb exists to avoid that.
AURA_UI_MODE=mini
AURA_MINI_WIDTH=340
AURA_MINI_HEIGHT=430
# true keeps the orb above other windows.
AURA_MINI_ON_TOP=false
# Applies to AURA_UI_MODE=hud only; the orb window is never fullscreen.
AURA_START_FULLSCREEN=true
# Animation frame rate. The orb is cheap to draw (~3.8 ms/frame), so 30 costs
# nothing and does not disturb audio. Lower it only if you switch to hud mode.
AURA_TARGET_FPS=30
# Frame rate while the audio path is live AND unbuffered - i.e. while recording
# from the mic. Speech playback is buffered and no longer needs a throttle.
AURA_AUDIO_FPS=16
